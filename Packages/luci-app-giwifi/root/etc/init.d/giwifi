#!/bin/sh /etc/rc.common
# GIWIFI 校园网自动登录服务（FanWRT）

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled username

	config_load giwifi
	config_get_bool enabled login enabled 0
	config_get username login username ''

	[ "$enabled" = "1" ] || {
		logger -t giwifi "未启用，跳过启动"
		return 0
	}

	[ -n "$username" ] || {
		logger -t giwifi "未配置帐号，跳过启动"
		return 0
	}

	procd_open_instance
	procd_set_param command /usr/sbin/giwifi-login --daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "giwifi"
}
